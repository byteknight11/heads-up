# Same value as the game server's AUTH_SECRET; signs sessions and socket tokens.
AUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
# Browser-facing WebSocket URL and server-side HTTP URL of the game server.
GAME_SERVER_WS_URL=ws://localhost:8080
GAME_SERVER_HTTP_URL=http://localhost:8080
# Google sign-in (https://console.cloud.google.com/apis/credentials). Leave blank to hide it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local development only: sign in with just a username.
DEV_LOGIN=1
